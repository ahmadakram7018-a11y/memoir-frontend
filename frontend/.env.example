# Supabase project — public/anon values, safe to expose client-side
# (that's what NEXT_PUBLIC_ means in Next.js). Get these from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed FastAPI backend (Hugging Face), no trailing
# slash. There is deliberately no localhost default anywhere in committed
# code — set this per environment (local dev: your local backend; Vercel:
# the real Hugging Face URL, once the backend is deployed).
NEXT_PUBLIC_API_URL=

# No OAuth-specific env var is needed. The Google sign-in redirect is built
# from window.location.origin at click time (see SignupForm.tsx /
# LoginForm.tsx), so it's automatically correct on localhost, every Vercel
# preview deployment, and production — one line of code instead of one env
# var per environment.
